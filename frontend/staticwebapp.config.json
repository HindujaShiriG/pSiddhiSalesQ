{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*.{css,js}", "/favicon.ico"]
  },
  "routes": [
    {
      "route": "/api/*",
      "allowedRoles": ["anonymous"]
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html"
    }
  },
  "globalHeaders": {
    "content-security-policy": "default-src 'self' 'unsafe-inline' 'unsafe-eval' https:; img-src 'self' data: https:;"
  },
  "mimeTypes": {
    ".json": "application/json"
  }
}
