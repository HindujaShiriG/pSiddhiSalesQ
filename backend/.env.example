# Copy to .env and fill as needed. All values have working local defaults.

# JSON Server mock CRM (falls back to ../data/crm_db.json if unreachable)
CRM_BASE_URL=http://localhost:3001

# SQLite database (default: backend/salesiq.db)
# DATABASE_URL=sqlite:///./salesiq.db

# Gemini — leave unset to use the deterministic offline narrative fallback
# GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-2.5-flash

# Frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
